# Architecture
BR2_arm=y
BR2_arm926t=y

# Global patch dir: fixes for stock (non-Ronetix) packages that can't
# be committed to the upstream linux4microchip/buildroot-mchp tree
# from here. See board/ronetix/README.md's "Global patches" section.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RONETIX_PATH)/global-patches"

# Linux headers same as kernel, a 6.6 series
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y

# Kernel: same repo/branch as pm9g45 (linux4microchip/linux,
# linux-6.6-mchp), since the AT91SAM9x5 family is covered by the same
# generic "at91_dt" defconfig and this kernel image is shared across
# the whole 5-chip family (G15/G25/G35/X25/X35); the SoC variant is
# detected by the kernel at runtime. Pinned to the exact commit
# verified to build and boot on real sam9x5-cm hardware (AT91SAM9X35)
# on 2026-09-15 -- happens to be the same commit already pinned for
# pm9g45, since the branch hadn't moved between the two builds. See
# board/ronetix/README.md.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/linux4microchip/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="c5ee3b5209256990ae272d97b69103e3289f2190"
BR2_LINUX_KERNEL_DEFCONFIG="at91_dt"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="microchip/at91sam9g15ek microchip/at91sam9g25ek microchip/at91sam9g35ek microchip/at91sam9x25ek microchip/at91sam9x35ek"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/common/patches/linux/0001-scripts-unifdef-avoid-constexpr-keyword.patch"

# Filesystem
BR2_TARGET_ROOTFS_UBIFS=y
BR2_TARGET_ROOTFS_UBIFS_LEBSIZE=0x1f000
BR2_TARGET_ROOTFS_UBI=y
BR2_TARGET_ROOTFS_UBI_SUBSIZE=2048

# Bootloaders
BR2_TARGET_AT91BOOTSTRAP3=y
BR2_TARGET_AT91BOOTSTRAP3_CUSTOM_GIT=y
BR2_TARGET_AT91BOOTSTRAP3_CUSTOM_REPO_URL="https://github.com/ronetix/at91bootstrap.git"
BR2_TARGET_AT91BOOTSTRAP3_CUSTOM_REPO_VERSION="at91bootstrap-3.10.4_rnx"
BR2_TARGET_AT91BOOTSTRAP3_DEFCONFIG="sam9x5_cm_nf_uboot"

# U-Boot: build on stock upstream (not a ronetix/u-boot fork -- there
# isn't a per-board one for this SoM anyway) and use the board defconfig
# already carried by that tree. Pinned to the same exact commit as
# pm9g45 (ffe4012789d5742fdd96c0e238138b1e83e4f460, the
# u-boot-2024.07-mchp branch tip as of 2026-09-14) -- aligned
# deliberately on 2026-09-15 after discovering the two boards had
# drifted to different commits of the same floating branch (see
# board/ronetix/README.md's "floating branch, stale download cache"
# gotcha); sam9x5-cm was previously pinned to
# f52c0efc94e2f3d3a567de29fbe380a38f9b2847 (tag linux4microchip-2025.04,
# 5 commits behind), which was independently verified booting on real
# hardware. Re-verify on hardware after aligning -- the two commits are
# close but not identical.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/linux4sam/u-boot-at91.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="ffe4012789d5742fdd96c0e238138b1e83e4f460"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="at91sam9x5ek_nandflash"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_PATCH="$(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/sam9x5-cm/patches/uboot/0001-configs-at91sam9x5ek_nandflash_defconfig-fix-dt-and-mac.patch"

# Host tools: SAM-BA, for initial/recovery flashing over the SoM's
# USB device port (see the Ronetix wiki's SAM9X5-CM page).
BR2_PACKAGE_HOST_SAM_BA=y

# Production test tool (GPIO loopback pair test + functional checks).
# See board/ronetix/README.md's "modtest" section.
BR2_PACKAGE_MODTEST=y
BR2_PACKAGE_MODTEST_SAM9X5_CM=y
