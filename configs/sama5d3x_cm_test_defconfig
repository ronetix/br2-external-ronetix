# sama5d3x-cm production test image.
#
# Everything here is identical to sama5d3x_cm_defconfig (the real
# production image) EXCEPT: this one boots a test-only device tree
# (board/ronetix/sama5d3x-cm/dts/sama5d35ek-modtest.dts) that disables
# the peripherals this carrier doesn't actually populate (second RJ45,
# SD card slot, an I2C1 device) so their pins can be exercised as plain
# GPIOs, and it includes modtest (the GPIO loopback + functional-check
# production test tool). See board/ronetix/README.md's "modtest"
# section for the full story, including why this needed a separate
# test-only dts rather than patching the production one: the affected
# peripherals are enabled and functioning correctly in the real
# production image (matching real, if empty, eval-kit-derived
# defaults) -- disabling them there would be a regression for anyone
# who actually does wire up a second RJ45/SD slot/I2C1 device to this
# carrier's headers later, not a fix.
#
# Keep this file's production-relevant settings (architecture, kernel/
# U-Boot/AT91Bootstrap3 pins and patches, filesystem) in sync with
# sama5d3x_cm_defconfig by hand -- there is no automatic mechanism
# tying the two together.

# Architecture
BR2_arm=y
BR2_cortex_a5=y

# Global patch dir: fixes for stock (non-Ronetix) packages that can't
# be committed to the upstream linux4microchip/buildroot-mchp tree
# from here. See board/ronetix/README.md's "Global patches" section.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RONETIX_PATH)/global-patches"

# Linux headers matching the kernel, 5.10 series
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_10=y

# Kernel: same source/patches as sama5d3x_cm_defconfig, but boots the
# test-only sama5d35ek-modtest.dts (see file header comment) instead of
# any of the stock in-tree dtbs -- BR2_LINUX_KERNEL_INTREE_DTS_NAME is
# deliberately left unset so only the test dtb is built, avoiding any
# ambiguity about which .dtb to flash on this image.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,linux4microchip,linux,linux4microchip-2021.10)/linux-linux4microchip-2021.10.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="sama5"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/sama5d3x-cm/dts/sama5d35ek-modtest.dts"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/sama5d3x-cm/patches/linux/0001-sama5d3xcm.dtsi-change-NAND-ECC-strength-from-4-to-8.patch $(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/common/patches/linux/0001-scripts-unifdef-avoid-constexpr-keyword.patch $(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/sama5d3x-cm/patches/linux/0002-sama5d3xmb_gmac.dtsi-use-rgmii-id-phy-mode-for-the-K.patch"

# Filesystem
BR2_TARGET_ROOTFS_UBIFS=y
BR2_TARGET_ROOTFS_UBIFS_LEBSIZE=0x1f000
BR2_TARGET_ROOTFS_UBI=y
BR2_TARGET_ROOTFS_UBI_SUBSIZE=2048

# AT91Bootstrap3: Ronetix fork used directly (per SoM bring-up, not a
# patch queue -- see board/ronetix/README.md).
BR2_TARGET_AT91BOOTSTRAP3=y
BR2_TARGET_AT91BOOTSTRAP3_CUSTOM_GIT=y
BR2_TARGET_AT91BOOTSTRAP3_CUSTOM_REPO_URL="https://github.com/ronetix/at91bootstrap.git"
BR2_TARGET_AT91BOOTSTRAP3_CUSTOM_REPO_VERSION="at91bootstrap-3.10.4_rnx"
BR2_TARGET_AT91BOOTSTRAP3_DEFCONFIG="sama5d3x_cm_nf_uboot"

# U-Boot: same as sama5d3x_cm_defconfig.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/linux4sam/u-boot-at91.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="u-boot-2024.07-mchp"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="sama5d3xek_nandflash"
BR2_TARGET_UBOOT_PATCH="$(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/sama5d3x-cm/patches/uboot/0001-configs-sama5d3xek_nandflash_defconfig-change-NAND-E.patch $(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/sama5d3x-cm/patches/uboot/0002-sama5d3xek_nandflash_defconfig-add-random-MAC-addres.patch $(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/sama5d3x-cm/patches/uboot/0003-configs-sama5d3xek_nandflash_defconfig-select-UBI-s-.patch $(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/sama5d3x-cm/patches/uboot/0004-arch-dts-sama5d3xcm.dtsi-use-rgmii-id-phy-mode-for-t.patch"

# Host tools: SAM-BA, for initial/recovery flashing over the SoM's
# USB device port (see the Ronetix wiki's SAMA5D3X-CM page).
BR2_PACKAGE_HOST_SAM_BA=y

# Bring up eth0 via DHCP automatically at boot (generates the
# /etc/network/interfaces "auto eth0 / iface eth0 inet dhcp" stanza),
# so it has a head start on link/DHCP before modtest's own eth check
# runs, instead of only coming up on demand.
BR2_SYSTEM_DHCP="eth0"

# Production test tool (GPIO loopback pair test + functional checks).
# See board/ronetix/README.md's "modtest" section.
BR2_PACKAGE_MODTEST=y
BR2_PACKAGE_MODTEST_SAMA5D3X_CM=y
