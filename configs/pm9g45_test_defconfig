# pm9g45 production test image.
#
# Everything here is identical to pm9g45_defconfig (the real production
# image) EXCEPT: this one includes modtest (the GPIO loopback +
# functional-check production test tool), auto-started at boot, and
# brings up eth0 via DHCP automatically. See board/ronetix/README.md's
# "modtest" section for what each check does.
#
# Like sama5d3x_cm_test_defconfig, this boots a test-only dts
# (board/ronetix/pm9g45/dts/pm9g45-modtest.dts): identical to the
# production pm9g45.dts (both of its patches replicated verbatim in
# the test dts itself, since it's built standalone and never goes
# through the patch queue below) plus one addition, a pinctrl hog that
# puts every BB9G45 J12/J13 pin package/modtest/files/config/
# pm9g45.pairs exercises into plain GPIO with an active pull-up --
# necessary, not optional, since this SoC's pinctrl driver ignores
# gpiotest's own runtime pull request. See pm9g45-modtest.dts's own
# header comment and board/ronetix/README.md for why pull-up, not
# pull-down.
#
# The two pm9g45-dts-specific kernel patches below (partition table,
# led0/usb-vbus) still apply during the build but have no effect on
# what actually boots here, since pm9g45-modtest.dts is a standalone
# file, not the in-tree pm9g45.dts they patch -- their changes are
# replicated by hand into pm9g45-modtest.dts instead. Keep that
# replication in sync if either patch changes.
#
# Keep this file's other production-relevant settings (architecture,
# kernel/U-Boot/AT91Bootstrap3 pins and patches, filesystem) in sync
# with pm9g45_defconfig by hand -- there is no automatic mechanism
# tying the two together.

# Architecture
BR2_arm=y
BR2_arm926t=y

# Global patch dir: fixes for stock (non-Ronetix) packages that can't
# be committed to the upstream linux4microchip/buildroot-mchp tree
# from here. See board/ronetix/README.md's "Global patches" section.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RONETIX_PATH)/global-patches"

# Linux headers same as kernel, a 6.6 series
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y

# Kernel: same source/pin/patches as pm9g45_defconfig -- see that
# file's own header comment for why the commit is pinned.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/linux4microchip/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="c5ee3b5209256990ae272d97b69103e3289f2190"
BR2_LINUX_KERNEL_DEFCONFIG="at91_dt"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/pm9g45/dts/pm9g45-modtest.dts"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/pm9g45/patches/linux/0001-dts-microchip-pm9g45.dts-modify-partition-table.patch $(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/common/patches/linux/0001-scripts-unifdef-avoid-constexpr-keyword.patch $(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/pm9g45/patches/linux/0002-dts-microchip-pm9g45.dts-fix-led0-gpio-add-usb-vbus.patch"

# Filesystem
BR2_TARGET_ROOTFS_UBIFS=y
BR2_TARGET_ROOTFS_UBIFS_MAXLEBCNT=2047
BR2_TARGET_ROOTFS_UBI=y

# Bootloaders
BR2_TARGET_AT91BOOTSTRAP3=y
BR2_TARGET_AT91BOOTSTRAP3_CUSTOM_GIT=y
BR2_TARGET_AT91BOOTSTRAP3_CUSTOM_REPO_URL="https://github.com/ronetix/at91bootstrap.git"
BR2_TARGET_AT91BOOTSTRAP3_CUSTOM_REPO_VERSION="at91bootstrap-3.10.4_rnx"
BR2_TARGET_AT91BOOTSTRAP3_DEFCONFIG="pm9g45_nf_uboot"

# U-Boot: same source/pin/patches as pm9g45_defconfig -- see that
# file's own header comment for why the commit is pinned.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/linux4sam/u-boot-at91.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="ffe4012789d5742fdd96c0e238138b1e83e4f460"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="pm9g45"
BR2_TARGET_UBOOT_PATCH="$(BR2_EXTERNAL_RONETIX_PATH)/board/ronetix/pm9g45/patches/uboot/0001-configs-pm9g45_defconfig-modify-to-boot-Linux-kernel.patch"

# Bring up eth0 via DHCP automatically at boot (generates the
# /etc/network/interfaces "auto eth0 / iface eth0 inet dhcp" stanza),
# so it has a head start on link/DHCP before modtest's own eth check
# runs, instead of only coming up on demand.
BR2_SYSTEM_DHCP="eth0"

# Production test tool (GPIO loopback pair test + functional checks).
# See board/ronetix/README.md's "modtest" section. Runs automatically
# at boot (logs to /var/log/modtest.log and the console) so a test
# station gets a result without an operator having to log in.
# pm9g45.pairs (see file header comment above) covers the BB9G45
# baseboard's J12/J13 headers.
BR2_PACKAGE_MODTEST=y
BR2_PACKAGE_MODTEST_PM9G45=y
BR2_PACKAGE_MODTEST_AUTOSTART=y
