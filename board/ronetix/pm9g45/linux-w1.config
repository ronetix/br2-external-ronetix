# Kernel config fragment: 1-Wire support for the DS2401 serial-number
# chip on the PM9G45 SoM (PA31, see board/ronetix/README.md's "pm9g45"
# section, patch 0003, for the pin/net details). Merged onto the
# at91_dt defconfig via BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES.
#
# No CONFIG_W1_SLAVE_* is needed: DS2401 (family 0x01) carries no data
# beyond its own ROM ID, which the w1 core exposes generically once
# found on the bus -- there's no dedicated slave driver for it in this
# kernel (or upstream), unlike the EEPROM/thermometer/etc. families
# that do carry data.
CONFIG_W1=y
CONFIG_W1_MASTER_GPIO=y
