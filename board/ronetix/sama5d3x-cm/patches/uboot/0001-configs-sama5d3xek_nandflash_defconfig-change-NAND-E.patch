From 10a902b45ee76b543db72a5b26096ef82a0e2511 Mon Sep 17 00:00:00 2001
From: Ilko Iliev <iliev@ronetix.at>
Date: Fri, 21 Feb 2025 10:21:12 +0100
Subject: [PATCH 2/3] configs/sama5d3xek_nandflash_defconfig - change NAND ECC
 from 4-bit to 8-bit

---
 configs/sama5d3xek_nandflash_defconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configs/sama5d3xek_nandflash_defconfig b/configs/sama5d3xek_nandflash_defconfig
index 7fff396907..cf147a44bd 100644
--- a/configs/sama5d3xek_nandflash_defconfig
+++ b/configs/sama5d3xek_nandflash_defconfig
@@ -87,7 +87,7 @@ CONFIG_SYS_FLASH_PROTECTION=y
 CONFIG_SYS_FLASH_CFI=y
 CONFIG_SYS_MAX_FLASH_SECT=131
 CONFIG_NAND_ATMEL=y
-CONFIG_PMECC_CAP=4
+CONFIG_PMECC_CAP=8
 CONFIG_SPL_GENERATE_ATMEL_PMECC_HEADER=y
 CONFIG_SYS_NAND_BLOCK_SIZE=0x20000
 CONFIG_SYS_NAND_ONFI_DETECTION=y
