# modtest defaults for sama5d3x-cm (SAMA5D3x, Cortex-A5).
#
# Sourced by /usr/bin/modtest at startup if installed at
# /etc/modtest/modtest.env. Anything left commented out here falls back to
# modtest.sh's own hardcoded default, or SKIPs the check entirely if there
# is no safe generic default (see the comments in modtest.sh itself).

ETH_IF=eth0
MTD_PART_LABEL=rootfs
USB_STORAGE_COUNT=2

# The SoC has MMC/SD controllers, but the SAMA5-CARRIER has no SD card
# slot wired up at all (see sama5d35ek-modtest.dts, which disables
# mmc0/mmc1 and reuses their pins for the GPIO loopback test). MMC_DEV
# stays unset on purpose.

# No I2C device on this carrier's I2C1 bus (see sama5d35ek-modtest.dts,
# which disables i2c1 entirely).
I2C_BUSES=0
