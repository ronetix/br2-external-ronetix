# modtest defaults for sam9x5-cm (AT91SAM9x5 family: G15/G25/G35/X25/X35).
#
# Sourced by /usr/bin/modtest at startup if installed at
# /etc/modtest/modtest.env. Anything left commented out here falls back to
# modtest.sh's own hardcoded default, or SKIPs the check entirely if there
# is no safe generic default (see the comments in modtest.sh itself).
#
# Real hardware is AT91SAM9X35; NAND/UBI/UBIFS rootfs, partition labeled
# "rootfs"; eth0 up with a working DHCP lease; both OHCI and EHCI USB
# ports enumerating storage devices.

ETH_IF=eth0
MTD_PART_LABEL=rootfs

# This SoM has two MMC/SD slots (atmel_mci controllers at f0008000 and
# f000c000), but which /dev/mmcblkN node a test card lands on hasn't been
# confirmed. Uncomment and set once you've booted with a test card in the
# fixture's slot and checked which device node it is:
# MMC_DEV=/dev/mmcblk0

# Fixture-specific - not yet defined (see board/ronetix/README.md's
# "modtest" section). Set these once known, or override at runtime:
#   USB_STORAGE_COUNT=<exact count on the production fixture>
#   I2C_BUSES="<bus numbers with a device present>"
