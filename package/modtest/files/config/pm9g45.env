# modtest defaults for pm9g45 (AT91SAM9G45).
#
# Sourced by /usr/bin/modtest at startup if installed at
# /etc/modtest/modtest.env. Anything left commented out here falls back to
# modtest.sh's own hardcoded default, or SKIPs the check entirely if there
# is no safe generic default (see the comments in modtest.sh itself).
#
# Real hardware: NAND/UBI/UBIFS rootfs, partition labeled "rootfs"; eth0
# up with a working link; both USB-A and USB-B ports enumerating storage
# devices.

ETH_IF=eth0
MTD_PART_LABEL=rootfs

# pm9g45 is NAND-only (no MMC/SD slot on the SoM) - leave MMC_DEV unset so
# modtest doesn't check for hardware that isn't there.
# MMC_DEV=

# Fixture-specific - not yet defined (see board/ronetix/README.md's
# "modtest" section). Set these once known, or override at runtime:
#   USB_STORAGE_COUNT=<exact count on the production fixture>
#   I2C_BUSES="<bus numbers with a device present>"
