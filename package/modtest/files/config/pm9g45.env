# modtest defaults for pm9g45 (AT91SAM9G45).
#
# Sourced by /usr/bin/modtest at startup if installed at
# /etc/modtest/modtest.env. Anything left commented out here falls back to
# modtest.sh's own hardcoded default, or SKIPs the check entirely if there
# is no safe generic default (see the comments in modtest.sh itself).
#
# Real hardware: NAND/UBI/UBIFS rootfs, partition labeled "rootfs"; eth0
# up with a working link; both USB-A and USB-B ports enumerating storage
# devices; an SD card in the SoM's mmc0 slot.

ETH_IF=eth0
MTD_PART_LABEL=rootfs

# The SoM does have an mmc0 slot (pm9g45.dts's mmc0 node, status "okay",
# 4-bit bus, cd-gpios on PD6) -- confirmed on real hardware with a card
# fitted: enumerates as mmcblk0. Set to the whole device, not a
# partition (e.g. mmcblk0p1), matching modtest.sh's own dd/blockdev
# check, which is a whole-device health check, not filesystem-specific.
MMC_DEV=/dev/mmcblk0

# Fixture-specific - not yet defined (see board/ronetix/README.md's
# "modtest" section). Set these once known, or override at runtime:
#   USB_STORAGE_COUNT=<exact count on the production fixture>
#   I2C_BUSES="<bus numbers with a device present>"
USB_STORAGE_COUNT=1
I2C_BUSES=0

# Passed straight through to memtester's own <mem>[SUFFIX] argument (see
# modtest.sh's own comment) -- keeps ddr_pattern's runtime reasonable on
# this SoC's slower ARM926EJ-S/single-bank DDR without testing all of
# this board's RAM. If this line is removed, modtest.sh's own default
# (1M) applies instead.
DDR_TEST_SIZE=64K
